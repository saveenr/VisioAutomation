<Project>

  <!--
    Solution-wide MSBuild defaults. Picked up automatically by every csproj
    under VisioAutomation_2010/ via MSBuild's Directory.Build.props convention
    — no <Import> needed in any csproj.

    Keep this file small and explainable. Each property here is a deliberate
    override of an SDK default; document the reason.
  -->

  <PropertyGroup>

    <!--
      Central Package Management. Package versions live in Directory.Packages.props
      (sibling file), not inline in csprojs. Eliminates version-skew risk across
      projects and makes the CI cache key trivially correct.
      Shared toolchain baseline with VDX: VS 2026 and the .NET 10 SDK.
    -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Modern C# everywhere. We don't multi-target, so a single language version
      across all 11 projects is consistent. Runtime-independent C# features
      (file-scoped namespaces, target-typed new(), pattern enhancements, etc.)
      become available even on net452 / net472.
    -->
    <LangVersion>14.0</LangVersion>

    <!--
      Preserve the legacy bin/Debug/ output layout (no TFM suffix).
      NuGet/VisioAutomation2010.nuspec packs DLLs from bin/Release/*.dll;
      VisioPowerShell/InstallForCurrentUser.ps1 defaults to Debug for development,
      while Publish-VisioPSToGallery.ps1 stages Release. We don't multi-target,
      so the SDK's TFM-suffixed default (bin/Debug/net452/) buys us nothing.
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Release stamps are checked against the nuspec and module manifest in CI.
         Keep assembly identity stable independently of the release version. -->
    <VersionPrefix>3.0.0</VersionPrefix>
    <VersionPrefix Condition="'$(MSBuildProjectName)' == 'VisioPowerShell'">4.7.2</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Authors>VisioAutomation contributors</Authors>
    <Company>$(Authors)</Company>
    <AssemblyTitle>$(MSBuildProjectName)</AssemblyTitle>
    <Product>$(MSBuildProjectName)</Product>
    <Copyright>Copyright &#169; 2021</Copyright>
    <RepositoryUrl>https://github.com/saveenr/VisioAutomation</RepositoryUrl>

  </PropertyGroup>

</Project>
